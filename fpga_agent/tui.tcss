$forge-bg: #171717;
$forge-panel: #1b1b19;
$forge-line: #ad795a;
$forge-muted: #8e824a;
$forge-accent: #ffd21f;
$forge-violet: #e6bd67;

Screen {
    background: $forge-bg;
    color: #e7e4ce;
}

#app-shell {
    height: 100%;
    width: 100%;
    padding: 0 2;
}

#transcript {
    height: 1fr;
    min-height: 5;
    padding: 0;
    scrollbar-size: 1 1;
}

#welcome {
    height: auto;
    margin: 0;
}

#wordmark {
    height: auto;
    margin-bottom: 1;
    color: $forge-accent;
}

#welcome-dashboard {
    height: auto;
    margin-bottom: 1;
}

#welcome-title {
    height: auto;
    color: #e7e4ce;
}

#welcome-note {
    height: auto;
    color: $forge-muted;
    margin-top: 0;
}

.message {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 0 1 0;
    border-bottom: solid #2a2922;
    background: transparent;
}

.message-row {
    width: 1fr;
    height: auto;
}

.message-glyph {
    width: 3;
    height: 1;
    padding-left: 1;
    color: $forge-muted;
}

.message.user .message-glyph { color: $forge-accent; }
.message.assistant .message-glyph { color: $forge-violet; }
.message.tool .message-glyph { color: #d4ad72; }
.message.system .message-glyph { color: $forge-muted; }

.message-content {
    width: 1fr;
    height: auto;
}

.message-title {
    height: 1;
    color: $forge-violet;
    text-style: bold;
}

Markdown {
    width: 1fr;
    height: auto;
    margin: 0;
    padding: 0;
    background: transparent;
}

MarkdownH1, MarkdownH2, MarkdownH3 { color: $forge-violet; }
MarkdownFence { background: #20201c; }

#task-status {
    display: none;
    height: 1;
    margin-bottom: 1;
    color: $forge-accent;
}

#logs {
    height: 10;
    max-height: 32%;
    margin-bottom: 1;
    padding: 0 1;
    border: round $forge-line;
    background: #131311;
    scrollbar-size: 1 1;
}

#suggestions {
    display: none;
    height: auto;
    max-height: 4;
    padding: 0 1 0 3;
    color: $forge-muted;
}

#composer {
    height: auto;
    min-height: 3;
    max-height: 8;
    margin-top: 0;
    padding: 0;
    border-top: solid $forge-line;
    border-bottom: solid $forge-line;
    background: $forge-bg;
}

#composer:focus-within {
    border-top: solid $forge-line;
    border-bottom: solid $forge-line;
}

#prompt-glyph {
    width: 3;
    height: 1;
    padding: 0 0 0 1;
    color: $forge-accent;
}

#prompt {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 6;
    padding: 0;
    border: none;
    background: $forge-bg;
}

#prompt:focus { border: none; }
TextArea > .text-area--cursor { background: #20bce8; color: $forge-bg; }

#status-line {
    height: 1;
    padding: 0 1;
    margin-top: 1;
    color: $forge-muted;
}

ModalScreen { align: center middle; background: #070b12 85%; }

.dialog {
    width: 78;
    max-width: 95%;
    max-height: 90%;
    height: auto;
    padding: 1 2;
    border: round $forge-violet;
    background: $forge-panel;
}

.dialog-title {
    height: 2;
    color: $forge-accent;
    text-style: bold;
}

.dialog Input { background: $forge-bg; border: tall $forge-line; }
.dialog Input:focus { border: tall $forge-accent; }
.muted { height: auto; color: $forge-muted; }

#picker { height: 24; }
#picker-options { height: 1fr; border: none; background: transparent; }
OptionList > .option-list--option-highlighted { background: #1a222c; color: $forge-accent; }
OptionList:focus { border: none; }

#connection { height: auto; }
#connection Label { height: 1; margin-top: 1; color: #a7b0c4; }
#connection Select { margin: 0; }
.dialog-buttons { height: 3; margin-top: 1; align: right middle; }
.dialog-buttons Button { margin-left: 1; border: none; }

#preview { width: 100; height: 90%; }
#preview VerticalScroll { height: 1fr; }

Screen.narrow #app-shell { padding: 0 1; }
